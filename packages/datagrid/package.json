{
  "name": "@testproject/datagrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --project tsconfig.build.json && node ./scripts/copy-css.mjs",
    "type-check": "vue-tsc --project tsconfig.build.json --noEmit",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.24",
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
  }
}
